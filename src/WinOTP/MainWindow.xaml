<Window x:Class="WinOTP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOTP">
  <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
    <Grid.Resources>
      <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style x:Key="AccountCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,10,14,12"/>
      </Style>
      <Style x:Key="CountdownTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
      </Style>
      <Style x:Key="CountdownFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WinOTPAccentBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="WindowTitleBar" Background="Transparent" Margin="16,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Branding/Square44x44Logo.targetsize-32.png" Width="20" Height="20" AutomationProperties.Name="WinOTP logo"/>
        <TextBlock Text="WinOTP" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="16,6,16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" PlaceholderText="Search accounts" AutomationProperties.Name="Search accounts" TextChanged="Search_Changed"
                 Height="36" MinHeight="36" CornerRadius="9" Padding="32,7,8,0" VerticalContentAlignment="Center"/>
        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
      </Grid>
      <Button x:Name="ShowCodesButton" Grid.Column="1" Content="Hide codes" Click="ShowCodes_Click"
              Style="{StaticResource ToolbarButtonStyle}" MinWidth="92" Padding="8,0"/>
      <Button Grid.Column="2" AutomationProperties.Name="Add account" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"
              Height="36" MinHeight="36" CornerRadius="9" Padding="10,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE710;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock Text="Add" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="3" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"
              Style="{StaticResource ToolbarButtonStyle}" Width="36" MinWidth="36" Padding="0">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Text="Import" Click="Import_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutItem Text="Backup" Click="Backup_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Settings" Click="Settings_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          </MenuFlyout>
        </Button.Flyout>
        <FontIcon Glyph="&#xE713;" FontSize="14"/>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="2" Padding="16,0,16,14" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="AccountList" Spacing="8"/>
    </ScrollViewer>
  </Grid>
</Window>
