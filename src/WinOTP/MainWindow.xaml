<Window x:Class="WinOTP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOTP">
  <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="WindowTitleBar" Background="Transparent" Margin="16,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Branding/Square44x44Logo.targetsize-32.png" Width="20" Height="20" AutomationProperties.Name="WinOTP logo"/>
        <TextBlock Text="WinOTP" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="16,4,16,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#C03C4148" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="4">
        <Grid ColumnSpacing="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" PlaceholderText="Search accounts" AutomationProperties.Name="Search accounts" TextChanged="Search_Changed" Background="Transparent" BorderThickness="0" MinWidth="100" VerticalAlignment="Center" Padding="10,8">
            <TextBox.Resources>
              <!-- Keep the search integrated into the shared toolbar in every input state. -->
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
            </TextBox.Resources>
          </TextBox>
          <Button x:Name="ShowCodesButton" Grid.Column="1" Content="Hide codes" Click="ShowCodes_Click" Style="{StaticResource SubtleButtonStyle}" Padding="10,8" MinHeight="40" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="Add" AutomationProperties.Name="Add account" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8" MinHeight="40" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Button Grid.Column="1" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" CornerRadius="16" Background="#455460" BorderBrush="#728895" Foreground="#83E7FF" VerticalAlignment="Center">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Text="Import" Click="Import_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutItem Text="Backup" Click="Backup_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Settings" Click="Settings_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          </MenuFlyout>
        </Button.Flyout>
        <FontIcon Glyph="&#xE713;" FontSize="14"/>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="2" Margin="20,0,20,12" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="AccountList" Spacing="0"><StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></StackPanel.ChildrenTransitions></StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
