<Application RequestedTheme="Dark" x:Class="WinOTP.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#60DDFF</Color>
          <Color x:Key="SystemAccentColorLight1">#69D2F8</Color>
          <Color x:Key="SystemAccentColorLight2">#39D4FF</Color>
          <Color x:Key="SystemAccentColorLight3">#B2EBFC</Color>
          <SolidColorBrush x:Key="WinOTPAccentBrush" Color="#60DDFF"/>
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CDCDCD"/>
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#CDCDCD"/>
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#14FFFFFF"/>
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1CFFFFFF"/>
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#12FFFFFF"/>
          <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#22FFFFFF"/>
          <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0BFFFFFF"/>
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF"/>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282D"/>
          <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="WinOTPAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable"/></Style>
      <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style TargetType="ContentDialog"><Setter Property="FontFamily" Value="Segoe UI Variable"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
