<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector=":is(Window)"><Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#202020"/><Setter Property="FontSize" Value="14"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="11,8"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#60DDFF"/><Setter Property="Foreground" Value="#06222B"/></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style Selector="TextBox.search"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="TextBox.search /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#60DDFF"/><Setter Property="Background" Value="#646464"/></Style>
</Styles>
